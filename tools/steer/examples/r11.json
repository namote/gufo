    "basis": "build/b1/r11/basis-avgx-k6.json",
    "options": {
     "direction_layer": 45,
     "direction_kind": "projected",
     "directions": 1,
     "preserve_norm": "off",
     "init": "build/b1/r10/steer10/jobs/631b98c155de13d8f1ec90ee5ab4b61c/best.json",
     "learn": "residual",
     "block_size": 4,
     "max_strength": 2,
     "lam": 2,
     "nu": 4,
     "guard_margin": 0.02,
     "steps": 60,
     "a": 0.1,
     "c": 0.15,
     "eval_every": 10,
     "seed": 11,
     "minibatch_chains": 12,
     "max_angle": 20,
     "c_dir": 0.04,
     "a_dir": 0.05,
     "dir_names": "r11-p,r11-m,r11-e"
    }
   }
  },
  {
   "name": "profile",
