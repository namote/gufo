       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5,
       0.5
      ]
     },
     "learn": "residual",
     "block_size": 4,
     "max_strength": 2,
     "lam": 2,
     "nu": 4,
     "guard_margin": 0.02,
     "steps": 100,
     "a": 0.2,
     "c": 0.15,
     "eval_every": 20,
     "seed": 1
    }
   }
  },
  {
   "name": "profile",
   "operation": "profile",
   "await_server": {
    "min_context": 40960
   },
   "params": {
    "train": {
     "from": "train",
     "key": "job"
    },
    "name": "recheck-r10",
    "upload": true
   }
  },
  {
   "name": "eval-aime25",
   "operation": "test",
   "params": {
    "set": {
     "kind": "math",
     "path": "build/b1/r10/aime25.jsonl",
     "max_tokens": 32768
    },
    "concurrency": 4,
    "configs": [
     {
      "name": "xhigh-r10",
      "reasoning_effort": "xhigh",
      "abliteration": {
       "enabled": true,
       "profile": "recheck-r10"
      }
     },
     {
      "name": "low-r10",
      "reasoning_effort": "low",
      "abliteration": {
       "enabled": true,
       "profile": "recheck-r10"
      }
     }
    ]
   }
  },
  {
   "name": "eval-code",
   "operation": "test",
   "params": {
    "set": {
     "kind": "coding",
     "path": "build/b1/r5-coding",
     "split": "eval"
    },
    "concurrency": 4,
    "configs": [
     {
      "name": "low-off",
      "reasoning_effort": "low",
      "sampling": {
       "chat_template_kwargs": {
        "enable_thinking": true
       },
       "temperature": 1.0,
