+class SeparatePoolContextTests(unittest.TestCase):
+    def test_pool_does_not_raise_http_context_limit(self):
+        class E(FakeEngine):
+            ctx, pool_ctx, sessions, ndt, draft_model = 4096, 8192, 2, 7, object()
+            cache = types.SimpleNamespace(max_num_tokens=8192)
+        eng = E("x")
+
+        async def fn(client):
+            models = await (await client.get("/v1/models")).json()
+            health = await (await client.get("/health")).json()
+            valid = await client.post("/v1/completions", json={"model": "m", "prompt": "w " * 100, "max_tokens": 10000})
+            await valid.read()
+            rejected = await client.post("/v1/completions", json={"model": "m", "prompt": "w " * 4096, "max_tokens": 1})
+            return models, health, valid.status, rejected.status
+        models, health, ok, rejected = with_client(eng, fn)
+        self.assertEqual(models["data"][0]["max_context"], 4096)
+        self.assertEqual((health["max_context"], health["kv_pool_tokens"]), (4096, 8192))
+        self.assertEqual((ok, rejected), (200, 400))
+        self.assertEqual(len(eng.calls), 1)
+        self.assertEqual(eng.calls[0][1]["max_tokens"], 4096 - 100 - 1 - 7)
+
+    def test_two_full_requests_fit_pool_without_requeue(self):
+        for prompt in (100, 131072, 250000, 262135):
+            reply = serve.reply_room(262144, prompt, 7)
+            self.assertGreater(reply, 0)
+            self.assertIsNone(serve.serve_compat.rq_budget(524288, 2, prompt, reply, 7))
+            pages = ReplyRoomTests.pages_needed(prompt, reply, 7)
+            self.assertLessEqual(2 * pages, 524288 // 256)
+
